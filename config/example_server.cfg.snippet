// Add plugin to your plugin list
// set qlx_plugins "DEFAULT,discord_ql_mover"

// Core Discord mover config
set qlx_dmoverDiscordBotToken "YOUR_DISCORD_BOT_TOKEN"
set qlx_dmoverDiscordGuildId "YOUR_DISCORD_GUILD_ID"
set qlx_dmoverDefaultChannelId "YOUR_DEFAULT_VOICE_CHANNEL_ID"
set qlx_dmoverRedChannelId "YOUR_RED_VOICE_CHANNEL_ID"
set qlx_dmoverBlueChannelId "YOUR_BLUE_VOICE_CHANNEL_ID"

// Optional behavior tuning
set qlx_dmoverCooldown "8"
set qlx_dmoverCommandPermission "2"
set qlx_dmoverDryRun "0"
set qlx_dmoverRequestTimeoutSeconds "8"
set qlx_dmoverAutoMoveTeamsOnCountdown "1"
set qlx_dmoverAutoMoveDefaultOnGameEnd "1"
set qlx_dmoverAutoMoveTeamsMinInterval "20"
